{
  "name": "partypaths",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Party Paths — demokratiskt party-DnD",
  "scripts": {
    "dev": "concurrently -n server,client -c coral,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test server/game/paths.test.ts server/rooms.join.test.ts",
    "deploy:cf": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nanoid": "^5.1.16",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
