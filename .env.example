# Railway / server environment
#
PUBLIC_APP_URL=https://partypaths.com
# Optional CORS (comma-separated). Default allows partypaths.com + localhost.
# CORS_ORIGIN=https://partypaths.com,https://www.partypaths.com
#
# Admin stats (startade spel per dag). Same token pattern as your other games.
# ADMIN_STATS_TOKEN=long-secret-string
# Then open:
#   https://<railway-url>/api/admin/stats?token=DIN_TOKEN&format=html
#
# Persistence (rooms across restarts) — REQUIRED in production
# Without this, rooms vanish on every Railway deploy/restart and joiners see
# "Hittade inget spel med den koden".
#
# 1. Railway → project → + New → Database → Redis
# 2. On the API service → Variables → Add variable reference REDIS_URL
#    (or paste the Redis URL manually)
# 3. Redeploy the API. Verify: GET /api/health → persist.configured: true
#
# REDIS_URL=redis://default:…@….railway.internal:6379
# Also keep a single replica on the API service until Redis is connected.
# Or mount a volume at /data (auto-detected) or set:
# PARTYPATHS_DATA_DIR=/data
